{
  "expo": {
    "name": "Urnik",
    "slug": "urnik",
    "version": "0.9.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "urnik",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tjas.urnik"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0e1116"
      },
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.tjas.urnik",
      "versionCode": 1,
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#4c8dff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan the WebUntis QR code when linking your account."
        }
      ],
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "916b918c-655e-4c16-a696-70eef68e5994"
      }
    }
  }
}
